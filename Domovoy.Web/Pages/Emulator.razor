@page "/emulator"
@page "/demo"
@inject ApiService Api
@inject AuthService Auth
@inject NavigationManager Nav
@implements IDisposable

@if (!Auth.IsAuthenticated)
{
    <div class="glass-card" style="text-align:center; margin-top:4rem;">
        <p style="color: var(--text-secondary); margin-bottom:1rem;">Необходима авторизация для запуска эмулятора</p>
        <button class="btn-primary" @onclick='() => Nav.NavigateTo("/login")'>Войти</button>
    </div>
    return;
}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem;">
    <div>
        <h2>🎮 Интерактивный эмулятор телеметрии</h2>
        <p style="color:var(--text-secondary); font-size:0.875rem;">
            Демонстрация полного сквозного цикла: отправка показаний датчика ➔ шина RabbitMQ ➔ вычисление правил ➔ реакция исполняющего устройства.
        </p>
    </div>
    <div style="display:flex; gap:0.5rem;">
        <button class="btn-primary" style="background:var(--accent-indigo);" @onclick="SetupDemoBundle" disabled="@isSettingUp">
            @(isSettingUp ? "⚙️ Настройка..." : "⚡ Быстрая настройка демо-комплекта")
        </button>
        <button class="btn-primary" style="background:var(--bg-surface-hover);" @onclick="RefreshLogs">
            ↻ Обновить
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div style="color:@(statusIsError ? "var(--accent-rose)" : "var(--accent-emerald)"); background:@(statusIsError ? "rgba(244,63,94,0.1)" : "rgba(16,185,129,0.1)"); border:1px solid @(statusIsError ? "var(--accent-rose)" : "var(--accent-emerald)"); border-radius:0.5rem; padding:0.75rem; margin-bottom:1rem; font-size:0.875rem;">
        @statusMessage
    </div>
}

<div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap:1.5rem; margin-bottom:1.5rem;">
    
    @* ── ЛЕВАЯ КОЛОНКА: Пульт датчика ── *@
    <div class="glass-card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
            <h3>📡 Датчик телеметрии (Sensor)</h3>
            <span class="badge" style="background:@(hasDeviceToken ? "rgba(16,185,129,0.2)" : "rgba(244,63,94,0.2)"); color:@(hasDeviceToken ? "var(--accent-emerald)" : "var(--accent-rose)");">
                @(hasDeviceToken ? "● Аутентифицирован" : "○ Требуется токен")
            </span>
        </div>

        <div class="form-group">
            <label>ID датчика (Network ID)</label>
            <input class="form-input" @bind="sensorDeviceId" placeholder="например: sensor-temp-01" />
        </div>

        <div class="form-group">
            <label>Секрет датчика (Device Secret)</label>
            <div style="display:flex; gap:0.5rem;">
                <input class="form-input" type="password" @bind="sensorSecret" placeholder="Секрет устройства" style="flex:1;" />
                <button class="btn-primary" style="padding:0.4rem 0.8rem; font-size:0.8rem; background:var(--accent-cyan);" @onclick="AuthenticateDevice" disabled="@isAuthenticating">
                    @(isAuthenticating ? "..." : "Войти")
                </button>
            </div>
        </div>

        <div style="margin:1.5rem 0; padding:1rem; background:rgba(255,255,255,0.03); border-radius:0.75rem; border:1px solid var(--border-color);">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
                <label style="font-weight:600;">Температура (°C):</label>
                <span style="font-size:1.5rem; font-weight:700; color:@GetTemperatureColor(temperature);">
                    @temperature.ToString("F1") °C
                </span>
            </div>

            <input type="range" min="15.0" max="38.0" step="0.5" 
                   value="@temperature" 
                   @oninput="OnTemperatureSliderChange" 
                   style="width:100%; accent-color:@GetTemperatureColor(temperature); cursor:pointer; height:8px;" />
            
            <div style="display:flex; justify-content:space-between; font-size:0.75rem; color:var(--text-secondary); margin-top:0.25rem;">
                <span>15°C (Холод)</span>
                <span style="color:var(--accent-cyan); font-weight:600;">Порог правила: 25.0°C</span>
                <span>38°C (Жара)</span>
            </div>

            <div style="display:flex; gap:0.5rem; margin-top:1rem; flex-wrap:wrap;">
                <button class="btn-primary" style="padding:0.3rem 0.6rem; font-size:0.75rem; background:var(--bg-surface-hover);" @onclick="() => SetTemperature(18.0)">
                    ❄️ 18°C (Норма)
                </button>
                <button class="btn-primary" style="padding:0.3rem 0.6rem; font-size:0.75rem; background:var(--bg-surface-hover);" @onclick="() => SetTemperature(22.5)">
                    🌤 22.5°C (Комфорт)
                </button>
                <button class="btn-primary" style="padding:0.3rem 0.6rem; font-size:0.75rem; background:var(--accent-amber); color:#000; font-weight:600;" @onclick="() => SetTemperature(27.0)">
                    🔥 27.0°C (Сработка > 25°C)
                </button>
                <button class="btn-primary" style="padding:0.3rem 0.6rem; font-size:0.75rem; background:var(--accent-rose); font-weight:600;" @onclick="() => SetTemperature(35.0)">
                    🚨 35°C (Тревога)
                </button>
            </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem; margin-bottom:1.5rem;">
            <div class="form-group" style="margin-bottom:0;">
                <label>Влажность (%)</label>
                <input class="form-input" type="number" @bind="humidity" />
            </div>
            <div class="form-group" style="margin-bottom:0;">
                <label>Статус питания</label>
                <select class="form-input" @bind="sensorStatus">
                    <option value="ON">ON (ВКЛ)</option>
                    <option value="OFF">OFF (ВЫКЛ)</option>
                </select>
            </div>
        </div>

        <div style="display:flex; gap:1rem;">
            <button class="btn-primary" style="flex:2; font-weight:600; background:linear-gradient(135deg, var(--accent-cyan), var(--accent-indigo));" 
                    @onclick="SendTelemetry" disabled="@isSending">
                @(isSending ? "🚀 Отправка..." : "🚀 Отправить телеметрию")
            </button>

            <button class="btn-primary" style="flex:1; background:@(isAutoSimulating ? "var(--accent-rose)" : "var(--bg-surface-hover)");"
                    @onclick="ToggleAutoSimulation">
                @(isAutoSimulating ? "⏹ Стоп" : "🔄 Авто (3с)")
            </button>
        </div>
    </div>

    @* ── ПРАВАЯ КОЛОНКА: Визуализатор исполнительного устройства ── *@
    <div class="glass-card" style="display:flex; flex-direction:column; justify-content:space-between;">
        <div>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
                <h3>💡 Исполняющее устройство (Actuator)</h3>
                <span class="badge" style="background:rgba(99,102,241,0.2); color:var(--accent-indigo);">
                    Mock Device (HTTP :30001)
                </span>
            </div>

            <div style="text-align:center; padding:2rem 1rem; margin:1rem 0; background:rgba(0,0,0,0.3); border-radius:1rem; border:1px solid var(--border-color);">
                
                @* Графическая лампа/актуатор *@
                <div style="font-size:5rem; filter: @(actuatorState ? "drop-shadow(0 0 30px #f59e0b) drop-shadow(0 0 60px #fbbf24)" : "none"); transition: all 0.4s ease; margin-bottom:0.5rem;">
                    @(actuatorState ? "💡" : "⚫")
                </div>

                <div style="font-size:1.25rem; font-weight:700; color:@(actuatorState ? "#fbbf24" : "var(--text-secondary)");">
                    @(actuatorState ? "ВКЛЮЧЕНО (Питание подано)" : "ВЫКЛЮЧЕНО (Ожидание)")
                </div>

                <p style="font-size:0.875rem; color:var(--text-secondary); margin-top:0.5rem;">
                    Целевое устройство: <code>@actuatorDeviceId</code>
                </p>
                <p style="font-size:0.8rem; color:var(--accent-cyan);">
                    Эндпоинт: <code>http://domovoy-mock-device:8080/api/command</code>
                </p>
            </div>

            @* Степпер цепочки событий *@
            <div style="background:rgba(255,255,255,0.02); padding:1rem; border-radius:0.75rem; border:1px solid var(--border-color);">
                <div style="font-weight:600; font-size:0.875rem; margin-bottom:0.75rem; color:var(--text-secondary);">
                    📡 Сквозной Pipeline обработки:
                </div>
                
                <div style="display:flex; flex-direction:column; gap:0.5rem; font-size:0.8rem;">
                    <div style="display:flex; align-items:center; gap:0.5rem; color:@(step1Active ? "var(--accent-emerald)" : "var(--text-secondary)");">
                        <span>@(step1Active ? "✅" : "○")</span>
                        <span>1. Прием телеметрии через Gateway (темп: <strong>@lastSentTemp.ToString("F1")°C</strong>)</span>
                    </div>
                    <div style="display:flex; align-items:center; gap:0.5rem; color:@(step2Active ? "var(--accent-emerald)" : "var(--text-secondary)");">
                        <span>@(step2Active ? "✅" : "○")</span>
                        <span>2. Публикация в RabbitMQ (<code>TelemetryReceivedEvent</code>)</span>
                    </div>
                    <div style="display:flex; align-items:center; gap:0.5rem; color:@(step3Active ? "var(--accent-emerald)" : "var(--text-secondary)");">
                        <span>@(step3Active ? "✅" : "○")</span>
                        <span>3. Движок правил: проверка <code>temperature > 25</code> ➔ @(lastSentTemp > 25 ? "Сработало (turn_on)" : "Не сработало")</span>
                    </div>
                    <div style="display:flex; align-items:center; gap:0.5rem; color:@(step4Active ? "var(--accent-emerald)" : "var(--text-secondary)");">
                        <span>@(step4Active ? "✅" : "○")</span>
                        <span>4. Диспетчер команд: отправка POST на Mock Device</span>
                    </div>
                    <div style="display:flex; align-items:center; gap:0.5rem; color:@(step5Active ? "var(--accent-emerald)" : "var(--text-secondary)");">
                        <span>@(step5Active ? "✅" : "○")</span>
                        <span>5. Исполнение команды: статус <strong>@(actuatorState ? "200 OK (SUCCESS)" : "IDLE")</strong></span>
                    </div>
                    <div style="display:flex; align-items:center; gap:0.5rem; color:@(step3Active && lastSentTemp > 25 ? "var(--accent-emerald)" : "var(--text-secondary)");">
                        <span>@(step3Active && lastSentTemp > 25 ? "✅" : "○")</span>
                        <span>6. Уведомление: отправка <code>RuleTriggeredEvent</code> ➔ Notification Service (Email / Telegram)</span>
                    </div>
                </div>
            </div>
        </div>

        <div style="margin-top:1rem; font-size:0.75rem; color:var(--text-secondary); text-align:center;">
            Автоматический опрос статуса команд каждые 2 секунды.
        </div>
    </div>
</div>

@* ── НИЖНЯЯ СЕКЦИЯ: Журнал сработавших команд ── *@
<div class="glass-card">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
        <h3>📋 Журнал выполнения команд в реальном времени</h3>
        <span style="font-size:0.8rem; color:var(--text-secondary);">Всего записей: @recentCommands.Count</span>
    </div>

    @if (recentCommands.Count == 0)
    {
        <p style="color:var(--text-secondary); font-size:0.875rem; text-align:center; padding:1.5rem;">
            Команды ещё не зафиксированы. Отправьте телеметрию с температурой выше 25°C для срабатывания правила.
        </p>
    }
    else
    {
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Время (UTC)</th>
                    <th>Устройство</th>
                    <th>Команда</th>
                    <th>Протокол & Эндпоинт</th>
                    <th>Статус</th>
                    <th>Результат</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cmd in recentCommands)
                {
                    <tr>
                        <td>@cmd.CreatedAt</td>
                        <td><code>@cmd.DeviceId</code></td>
                        <td><span class="badge" style="background:var(--accent-indigo);">@cmd.Command</span></td>
                        <td><code>@cmd.Endpoint</code></td>
                        <td>
                            @if (cmd.Status.Equals("success", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge badge-online">УСПЕХ (200 OK)</span>
                            }
                            else
                            {
                                <span class="badge badge-offline">@cmd.Status</span>
                            }
                        </td>
                        <td>
                            @if (cmd.Status.Equals("success", StringComparison.OrdinalIgnoreCase))
                            {
                                <span style="color:var(--accent-emerald); font-size:0.8rem;">Команда выполнена на устройстве</span>
                            }
                            else
                            {
                                <span style="color:var(--accent-rose); font-size:0.8rem;">@cmd.ErrorMessage</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private string sensorDeviceId = $"demo-sensor-{Random.Shared.Next(100, 999)}";
    private string sensorSecret = "";
    private string actuatorDeviceId = "demo-lamp-actuator";
    private string? deviceToken = null;

    private double temperature = 27.5;
    private double lastSentTemp = 27.5;
    private int humidity = 55;
    private string sensorStatus = "ON";

    private bool hasDeviceToken => !string.IsNullOrEmpty(deviceToken);
    private bool isAuthenticating = false;
    private bool isSending = false;
    private bool isSettingUp = false;
    private bool isAutoSimulating = false;

    private bool actuatorState = false;

    // Pipeline steps indicators
    private bool step1Active = false;
    private bool step2Active = false;
    private bool step3Active = false;
    private bool step4Active = false;
    private bool step5Active = false;

    private string? statusMessage;
    private bool statusIsError = false;

    private System.Threading.Timer? pollTimer;
    private System.Threading.Timer? autoSimTimer;

    private class CommandLogItem
    {
        public string DeviceId { get; set; } = "";
        public string Command { get; set; } = "";
        public string Status { get; set; } = "";
        public string Endpoint { get; set; } = "";
        public string ErrorMessage { get; set; } = "";
        public string CreatedAt { get; set; } = "";
    }

    private List<CommandLogItem> recentCommands = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshLogs();
            pollTimer = new System.Threading.Timer(async _ =>
            {
                await InvokeAsync(async () =>
                {
                    await RefreshLogs();
                    StateHasChanged();
                });
            }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        pollTimer?.Dispose();
        autoSimTimer?.Dispose();
    }

    private string GetTemperatureColor(double temp)
    {
        if (temp < 20.0) return "var(--accent-cyan)";
        if (temp <= 25.0) return "var(--accent-emerald)";
        if (temp <= 30.0) return "#f59e0b";
        return "var(--accent-rose)";
    }

    private void OnTemperatureSliderChange(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var val))
        {
            temperature = val;
        }
    }

    private void SetTemperature(double val)
    {
        temperature = val;
    }

    private async Task SetupDemoBundle()
    {
        isSettingUp = true;
        statusMessage = null;

        try
        {
            // Генерируем уникальный ID если текущий уже был использован или пуст
            if (string.IsNullOrWhiteSpace(sensorDeviceId) || sensorDeviceId == "demo-temp-sensor")
            {
                sensorDeviceId = $"demo-sensor-{Random.Shared.Next(100, 999)}";
            }

            // 1. Регистрируем и настраиваем датчик-устройство с эндпоинтом Mock Device
            var (ok1, sec1, err1) = await Api.CreateDeviceAsync(
                sensorDeviceId, 
                "Демо-датчик и лампа", 
                "HTTP", 
                "http://domovoy-mock-device:8080/api/command");

            if (!ok1 && (err1?.Contains("already", StringComparison.OrdinalIgnoreCase) == true || err1?.Contains("400") == true))
            {
                sensorDeviceId = $"demo-sensor-{Random.Shared.Next(100, 999)}";
                var retryReg = await Api.CreateDeviceAsync(
                    sensorDeviceId, 
                    "Демо-датчик и лампа", 
                    "HTTP", 
                    "http://domovoy-mock-device:8080/api/command");
                sec1 = retryReg.Secret;
            }

            if (!string.IsNullOrEmpty(sec1))
            {
                sensorSecret = sec1;
            }

            // Дополнительно обновляем эндпоинт датчика в DeviceManager
            await Api.UpdateDeviceAsync(sensorDeviceId, new
            {
                name = "Демо-датчик и лампа",
                protocol = "HTTP",
                endpoint = "http://domovoy-mock-device:8080/api/command"
            });

            // 2. Создаем правило автоматизации для датчика: включение при > 25°C
            await Api.CreateRuleAsync(new
            {
                name = $"Авто-включение при жаре ({sensorDeviceId})",
                deviceId = sensorDeviceId,
                condition = "temperature > 25",
                command = "turn_on",
                commandParams = "{\"mode\": \"auto\"}",
                priority = 1
            });

            // 3. Создаем правило автоматизации: выключение при <= 25°C
            await Api.CreateRuleAsync(new
            {
                name = $"Авто-выключение при норме ({sensorDeviceId})",
                deviceId = sensorDeviceId,
                condition = "temperature <= 25",
                command = "turn_off",
                commandParams = "{\"mode\": \"auto\"}",
                priority = 2
            });

            // 4. Аутентифицируем сенсор
            await AuthenticateDevice();

            statusMessage = $"✅ Демо-комплект '{sensorDeviceId}' успешно настроен! Устройство и правила включения/выключения готовы к тесту.";
            statusIsError = false;
        }
        catch (Exception ex)
        {
            statusMessage = $"Ошибка настройки: {ex.Message}";
            statusIsError = true;
        }

        isSettingUp = false;
    }

    private async Task AuthenticateDevice()
    {
        if (string.IsNullOrWhiteSpace(sensorDeviceId) || string.IsNullOrWhiteSpace(sensorSecret))
        {
            statusMessage = "Укажите ID датчика и его секрет (или нажмите 'Быстрая настройка демо-комплекта').";
            statusIsError = true;
            return;
        }

        isAuthenticating = true;
        var (ok, token, err) = await Api.AuthenticateDeviceAsync(sensorDeviceId, sensorSecret);
        isAuthenticating = false;

        if (ok && !string.IsNullOrEmpty(token))
        {
            deviceToken = token;
            statusMessage = $"✅ Датчик '{sensorDeviceId}' успешно аутентифицирован. Токен получен!";
            statusIsError = false;
        }
        else
        {
            statusMessage = $"Ошибка аутентификации: {err}";
            statusIsError = true;
        }
    }

    private async Task SendTelemetry()
    {
        if (!hasDeviceToken)
        {
            await AuthenticateDevice();
            if (!hasDeviceToken) return;
        }

        isSending = true;
        lastSentTemp = temperature;

        // Reset and trigger stepper
        step1Active = true;
        step2Active = false;
        step3Active = false;
        step4Active = false;
        step5Active = false;
        StateHasChanged();

        var telemetryPayload = new
        {
            temperature = Math.Round(temperature, 1),
            humidity = humidity,
            status = sensorStatus
        };

        var (ok, resp, err) = await Api.SendDeviceTelemetryAsync(sensorDeviceId, deviceToken!, telemetryPayload);
        isSending = false;

        if (ok)
        {
            step2Active = true;
            statusMessage = $"📡 Телеметрия отправлена (температура: {temperature:F1}°C)!";
            statusIsError = false;

            // Simulate pipeline progression
            await Task.Delay(300);
            step3Active = true;
            StateHasChanged();

            await Task.Delay(400);
            step4Active = true;
            if (temperature > 25.0)
            {
                actuatorState = true;
                step5Active = true;
            }
            else
            {
                actuatorState = false;
            }
            StateHasChanged();

            await Task.Delay(1000);
            await RefreshLogs();
        }
        else
        {
            statusMessage = $"Ошибка отправки телеметрии: {err}";
            statusIsError = true;
        }
    }

    private void ToggleAutoSimulation()
    {
        isAutoSimulating = !isAutoSimulating;
        if (isAutoSimulating)
        {
            autoSimTimer = new System.Threading.Timer(async _ =>
            {
                await InvokeAsync(async () =>
                {
                    // Random small temperature variation around current
                    var delta = (new Random().NextDouble() - 0.45) * 1.5;
                    temperature = Math.Round(Math.Clamp(temperature + delta, 16.0, 36.0), 1);
                    await SendTelemetry();
                    StateHasChanged();
                });
            }, null, TimeSpan.Zero, TimeSpan.FromSeconds(3));
        }
        else
        {
            autoSimTimer?.Dispose();
            autoSimTimer = null;
        }
    }

    private async Task RefreshLogs()
    {
        var res = await Api.GetCommandsLogsAsync(null, 15);
        if (res.HasValue && res.Value.ValueKind == System.Text.Json.JsonValueKind.Array)
        {
            recentCommands.Clear();
            foreach (var item in res.Value.EnumerateArray())
            {
                var dev = GetStr(item, "deviceId", "DeviceId");
                var cmd = GetStr(item, "command", "Command");
                var st  = GetStr(item, "status", "Status");
                var ep  = GetStr(item, "endpoint", "Endpoint");
                var err = GetStr(item, "errorMessage", "ErrorMessage");
                var ca  = GetStr(item, "createdAt", "CreatedAt");

                recentCommands.Add(new CommandLogItem
                {
                    DeviceId = dev,
                    Command = cmd,
                    Status = string.IsNullOrEmpty(st) ? "pending" : st,
                    Endpoint = ep,
                    ErrorMessage = err,
                    CreatedAt = ca
                });

                // Update live actuator state if the latest command was for our actuator
                if (dev.Equals(actuatorDeviceId, StringComparison.OrdinalIgnoreCase) || dev.Contains("lamp", StringComparison.OrdinalIgnoreCase))
                {
                    if (cmd.Equals("turn_on", StringComparison.OrdinalIgnoreCase) && st.Equals("success", StringComparison.OrdinalIgnoreCase))
                    {
                        actuatorState = true;
                    }
                    else if (cmd.Equals("turn_off", StringComparison.OrdinalIgnoreCase) && st.Equals("success", StringComparison.OrdinalIgnoreCase))
                    {
                        actuatorState = false;
                    }
                }
            }
        }
    }

    private static string GetStr(System.Text.Json.JsonElement el, string p1, string p2)
    {
        if (el.TryGetProperty(p1, out var val) && val.ValueKind == System.Text.Json.JsonValueKind.String) return val.GetString() ?? "";
        if (el.TryGetProperty(p2, out val) && val.ValueKind == System.Text.Json.JsonValueKind.String) return val.GetString() ?? "";
        return "";
    }
}
