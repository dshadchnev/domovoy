@page "/login"
@inject AuthService Auth
@inject NavigationManager Nav

<div style="display:flex; justify-content:center; align-items:center; min-height:75vh;">
    <div class="glass-card" style="width:420px;">
        <h2 style="text-align:center; margin-bottom:1.5rem;">
            @(isRegisterMode ? "Регистрация в системе" : "Вход в систему")
        </h2>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div style="color:var(--accent-rose); background:rgba(244,63,94,0.1); border:1px solid var(--accent-rose); border-radius:0.5rem; padding:0.75rem; margin-bottom:1rem; font-size:0.875rem;">
                ⚠️ @errorMessage
            </div>
        }

        <div class="form-group">
            <label>Имя пользователя / Логин <span style="color:var(--accent-rose)">*</span></label>
            <input class="form-input" @bind="username" placeholder="например: romantsovpavel" />
        </div>

        @if (isRegisterMode)
        {
            <div class="form-group">
                <label>Электронная почта (Email) <span style="color:var(--accent-rose)">*</span></label>
                <input class="form-input" type="email" @bind="email" placeholder="user@example.com" />
            </div>
            <div style="display:flex; gap:1rem;">
                <div class="form-group" style="flex:1;">
                    <label>Имя</label>
                    <input class="form-input" @bind="firstName" placeholder="Иван" />
                </div>
                <div class="form-group" style="flex:1;">
                    <label>Фамилия</label>
                    <input class="form-input" @bind="lastName" placeholder="Иванов" />
                </div>
            </div>
        }

        <div class="form-group">
            <label>Пароль <span style="color:var(--accent-rose)">*</span></label>
            <input class="form-input" type="password" @bind="password" placeholder="••••••••" />
        </div>

        <button class="btn-primary" style="width:100%; margin-top:1rem; padding:0.75rem;" @onclick="SubmitForm" disabled="@isSubmitting">
            @(isSubmitting ? "Выполняется..." : (isRegisterMode ? "Зарегистрироваться" : "Войти"))
        </button>

        <div style="text-align:center; margin-top:1.5rem;">
            <button style="background:none; border:none; color:var(--accent-cyan); cursor:pointer; font-size:0.875rem;" @onclick="ToggleMode">
                @(isRegisterMode ? "Уже есть аккаунт? Войти" : "Нет аккаунта? Зарегистрироваться")
            </button>
        </div>
    </div>
</div>

@code {
    private bool isRegisterMode = false;
    private bool isSubmitting = false;
    private string? errorMessage;

    private string username = "";
    private string email = "";
    private string firstName = "";
    private string lastName = "";
    private string password = "";

    private void ToggleMode()
    {
        isRegisterMode = !isRegisterMode;
        errorMessage = null;
    }

    private async Task SubmitForm()
    {
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Пожалуйста, заполните имя пользователя и пароль.";
            return;
        }

        if (isRegisterMode && string.IsNullOrWhiteSpace(email))
        {
            errorMessage = "Электронная почта обязательна для регистрации.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;

        if (isRegisterMode)
        {
            var success = await Auth.RegisterAsync(username, email, password, firstName, lastName);
            isSubmitting = false;
            if (success)
            {
                Nav.NavigateTo("/");
            }
            else
            {
                errorMessage = "Ошибка при регистрации аккаунта.";
            }
        }
        else
        {
            var success = await Auth.LoginAsync(username, password);
            isSubmitting = false;
            if (success)
            {
                Nav.NavigateTo("/");
            }
            else
            {
                errorMessage = "Неверное имя пользователя или пароль.";
            }
        }
    }
}
