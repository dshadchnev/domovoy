@page "/devices"
@inject ApiService Api
@inject AuthService Auth
@inject NavigationManager Nav

@if (!Auth.IsAuthenticated)
{
    <div class="glass-card" style="text-align:center; margin-top:4rem;">
        <p style="color: var(--text-secondary); margin-bottom:1rem;">Необходима авторизация</p>
        <button class="btn-primary" @onclick='() => Nav.NavigateTo("/login")'>Войти</button>
    </div>
    return;
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
    <h2>Управление устройствами</h2>
    <button class="btn-primary" @onclick="OpenCreateModal">+ Зарегистрировать устройство</button>
</div>

@if (!string.IsNullOrEmpty(globalError))
{
    <div style="color: var(--accent-rose); background: rgba(244,63,94,0.1); border: 1px solid var(--accent-rose); border-radius: 0.5rem; padding: 0.75rem; margin-bottom: 1rem;">
        ⚠️ @globalError
    </div>
}

<div class="glass-card">
    @if (isLoading)
    {
        <p style="color: var(--text-secondary);">Загрузка устройств...</p>
    }
    else if (devices.Count == 0)
    {
        <p style="color: var(--text-secondary);">Нет зарегистрированных устройств. Нажмите «+ Зарегистрировать устройство».</p>
    }
    else
    {
        <table class="table-custom">
            <thead>
                <tr>
                    <th>ID устройства (Network ID)</th>
                    <th>Название</th>
                    <th>Протокол</th>
                    <th>Дата регистрации</th>
                    <th style="text-align:center;">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dev in devices)
                {
                    <tr>
                        <td><code>@dev.NetworkDeviceId</code></td>
                        <td><strong>@dev.Name</strong></td>
                        <td><span class="badge badge-online">@dev.Protocol</span></td>
                        <td>@dev.RegisteredAt</td>
                        <td style="text-align:center; display:flex; gap:0.5rem; justify-content:center;">
                            <button class="btn-primary"
                                    style="padding:0.25rem 0.75rem; font-size:0.8rem; background:var(--accent-cyan);"
                                    @onclick="() => OpenEditModal(dev)">✏️ Изменить</button>
                            <button class="btn-primary"
                                    style="padding:0.25rem 0.75rem; font-size:0.8rem; background:var(--accent-rose);"
                                    @onclick="() => OpenDeleteConfirm(dev)">🗑 Удалить</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@* ── Create / Edit Modal ── *@
@if (showCreateModal)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.75);display:flex;align-items:center;justify-content:center;z-index:200;">
        <div class="glass-card" style="width:460px;">
            <h3 style="margin-bottom:1rem;">@(isEditMode ? "Редактирование устройства" : "Регистрация нового устройства")</h3>

            @if (!string.IsNullOrEmpty(modalError))
            {
                <div style="color:var(--accent-rose);background:rgba(244,63,94,0.1);border:1px solid var(--accent-rose);border-radius:0.5rem;padding:0.75rem;margin-bottom:1rem;font-size:0.875rem;">
                    ⚠️ @modalError
                </div>
            }

            <div class="form-group">
                <label>ID устройства (Network ID) <span style="color:var(--accent-rose)">*</span></label>
                <input class="form-input" @bind="formDeviceId" placeholder="например: temp-sensor-01" disabled="@isEditMode" />
                @if (isEditMode)
                {
                    <small style="color:var(--text-secondary);">ID нельзя изменить после регистрации</small>
                }
            </div>
            <div class="form-group">
                <label>Название устройства</label>
                <input class="form-input" @bind="formName" placeholder="например: Датчик в спальне" />
            </div>

            <div style="display:flex; gap:1rem;">
                <div class="form-group" style="flex:1;">
                    <label>Протокол</label>
                    <select class="form-input" @bind="formProtocol">
                        <option>HTTP</option>
                        <option>MQTT</option>
                        <option>ZIGBEE</option>
                        <option>MODBUS</option>
                    </select>
                </div>
            </div>

            @* Расширенные настройки (опционально) *@
            <div style="margin-top:0.5rem; margin-bottom:1rem;">
                <button type="button" style="background:none; border:none; color:var(--accent-cyan); font-size:0.875rem; cursor:pointer; padding:0;"
                        @onclick="() => showAdvanced = !showAdvanced">
                    @(showAdvanced ? "▼ Скрыть доп. параметры" : "► Дополнительные параметры (Endpoint URL)")
                </button>

                @if (showAdvanced)
                {
                    <div class="form-group" style="margin-top:0.75rem;">
                        <label>Endpoint URL (необязательно)</label>
                        <input class="form-input" @bind="formEndpoint" placeholder="http://192.168.1.50/api" />
                    </div>
                }
            </div>

            <div style="display:flex;gap:1rem;margin-top:1.5rem;">
                <button class="btn-primary" style="flex:1;" @onclick="SaveDevice" disabled="@isSaving">
                    @(isSaving ? "Сохранение..." : (isEditMode ? "Сохранить" : "Зарегистрировать"))
                </button>
                <button class="btn-primary" style="flex:1;background:var(--bg-surface-hover);" @onclick="CloseModal">Отмена</button>
            </div>
        </div>
    </div>
}

@* ── Delete Confirmation ── *@
@if (showDeleteConfirm && deviceToDelete != null)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.75);display:flex;align-items:center;justify-content:center;z-index:200;">
        <div class="glass-card" style="width:400px; text-align:center;">
            <h3 style="margin-bottom:0.5rem; color:var(--accent-rose);">⚠️ Удалить устройство?</h3>
            <p style="color:var(--text-secondary); margin-bottom:1.5rem;">
                Устройство <strong>@deviceToDelete.Name</strong> (<code>@deviceToDelete.NetworkDeviceId</code>) будет удалено.
            </p>
            @if (!string.IsNullOrEmpty(modalError))
            {
                <div style="color:var(--accent-rose); margin-bottom:1rem; font-size:0.875rem;">⚠️ @modalError</div>
            }
            <div style="display:flex;gap:1rem;">
                <button class="btn-primary" style="flex:1;background:var(--accent-rose);" @onclick="ConfirmDelete" disabled="@isSaving">
                    @(isSaving ? "Удаление..." : "Да, удалить")
                </button>
                <button class="btn-primary" style="flex:1;background:var(--bg-surface-hover);" @onclick="() => { showDeleteConfirm = false; modalError = null; }">Отмена</button>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading;
    private bool isSaving;
    private bool showCreateModal;
    private bool showDeleteConfirm;
    private bool isEditMode;
    private bool showAdvanced;

    private string? globalError;
    private string? modalError;

    // Form fields
    private string formDeviceId = "";
    private string formName = "";
    private string formProtocol = "HTTP";
    private string formEndpoint = "";

    private class DeviceItem
    {
        public string NetworkDeviceId { get; set; } = "";
        public string Name { get; set; } = "";
        public string Protocol { get; set; } = "HTTP";
        public string Endpoint { get; set; } = "";
        public string RegisteredAt { get; set; } = "";
    }

    private DeviceItem? deviceToDelete;
    private List<DeviceItem> devices = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadDevices();
            StateHasChanged();
        }
    }

    private async Task LoadDevices()
    {
        isLoading = true;
        globalError = null;
        var res = await Api.GetDevicesMgmtAsync();
        devices.Clear();
        if (res.HasValue && res.Value.ValueKind == System.Text.Json.JsonValueKind.Array)
        {
            foreach (var item in res.Value.EnumerateArray())
            {
                devices.Add(new DeviceItem
                {
                    NetworkDeviceId = item.TryGetProperty("networkDeviceId", out var p1) ? p1.GetString() ?? "" : "",
                    Name            = item.TryGetProperty("name",            out var p2) ? p2.GetString() ?? "" : "",
                    Protocol        = item.TryGetProperty("protocol",        out var p3) ? p3.GetString() ?? "HTTP" : "HTTP",
                    Endpoint        = item.TryGetProperty("endpoint",        out var p4) ? p4.GetString() ?? "" : "",
                    RegisteredAt    = item.TryGetProperty("createdAt",       out var p5) ? p5.GetString() ?? "" : ""
                });
            }
        }
        isLoading = false;
    }

    private void OpenCreateModal()
    {
        isEditMode = false;
        showAdvanced = false;
        formDeviceId = ""; formName = ""; formProtocol = "HTTP"; formEndpoint = "";
        modalError = null;
        showCreateModal = true;
    }

    private void OpenEditModal(DeviceItem dev)
    {
        isEditMode = true;
        showAdvanced = !string.IsNullOrEmpty(dev.Endpoint);
        formDeviceId = dev.NetworkDeviceId;
        formName     = dev.Name;
        formProtocol = dev.Protocol;
        formEndpoint = dev.Endpoint;
        modalError   = null;
        showCreateModal = true;
    }

    private void CloseModal()
    {
        showCreateModal = false;
        modalError = null;
    }

    private async Task SaveDevice()
    {
        if (string.IsNullOrWhiteSpace(formDeviceId))
        {
            modalError = "ID устройства обязателен.";
            return;
        }

        isSaving = true;
        modalError = null;

        var finalEndpoint = string.IsNullOrWhiteSpace(formEndpoint) ? "http://localhost" : formEndpoint.Trim();

        if (isEditMode)
        {
            var updateDto = new { name = formName, protocol = formProtocol, endpoint = finalEndpoint };
            var (ok, err) = await Api.UpdateDeviceAsync(formDeviceId, updateDto);
            isSaving = false;
            if (ok) { CloseModal(); await LoadDevices(); }
            else    { modalError = err ?? "Ошибка обновления устройства."; }
        }
        else
        {
            var createDto = new
            {
                networkDeviceId = formDeviceId.Trim(),
                name            = string.IsNullOrWhiteSpace(formName) ? formDeviceId.Trim() : formName.Trim(),
                protocol        = formProtocol,
                endpoint        = finalEndpoint
            };
            var (ok, err) = await Api.CreateDeviceAsync(createDto);
            isSaving = false;
            if (ok) { CloseModal(); await LoadDevices(); }
            else    { modalError = err ?? "Ошибка создания устройства."; }
        }
    }

    private void OpenDeleteConfirm(DeviceItem dev)
    {
        deviceToDelete = dev;
        modalError     = null;
        showDeleteConfirm = true;
    }

    private async Task ConfirmDelete()
    {
        if (deviceToDelete == null) return;
        isSaving = true;
        modalError = null;
        var (ok, err) = await Api.DeleteDeviceAsync(deviceToDelete.NetworkDeviceId);
        isSaving = false;
        if (ok) { showDeleteConfirm = false; deviceToDelete = null; await LoadDevices(); }
        else    { modalError = err ?? "Ошибка удаления."; }
    }
}
