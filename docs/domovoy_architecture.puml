@startuml Domovoy_Architecture
!theme C4_Theme from https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/themes/puml-theme-C4_Theme.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title System Context & Container Diagram for Domovoy (Smart Home System)

Person(user, "User / Client", "Manages devices, rules, and commands via Web/Mobile interface")
System_Ext(iot_device, "IoT Device / Simulator", "Sends telemetry and receives commands (HTTP, MQTT, Zigbee)")
System_Ext(telegram, "Telegram API", "Delivers instant alert messages to users")
System_Ext(smtp, "SMTP Server / MailKit", "Sends email notifications")

System_Boundary(domovoy_system, "Domovoy System") {
    Container(web_app, "Web Client (domovoy-web)", "Blazor WASM / Server :5200", "Interactive user dashboard and device management UI")
    Container(gateway, "API Gateway (domovoy-gateway)", "ASP.NET Core, YARP :8085", "Routes HTTP requests, enriches headers with claims cached in Redis, logs security events")
    Container(auth_service, "Auth Service (domovoy-auth)", "ASP.NET Core, OpenIddict :8086", "Handles user/device auth, token issuance, secrets rotation, and telemetry ingress")
    Container(device_manager, "Device Manager (domovoy-device-manager)", "ASP.NET Core :8087", "Manages device metadata (names, rooms, protocols, endpoints)")
    Container(rules_engine, "Rules Engine (domovoy-rules-engine)", "ASP.NET Core, NCalc :8088", "Stores automation rules, evaluates telemetry data, triggers command & notification events")
    Container(command_dispatcher, "Command Dispatcher (domovoy-command-dispatcher)", "ASP.NET Core :8089", "Receives command execution events, logs commands, and dispatches them via HTTP/MQTT/Zigbee")
    Container(notification_service, "Notification Service (domovoy-notification)", "ASP.NET Core :8090", "Consumes rule triggered/command failed events, sends Telegram/Email alerts")
    Container(dashboard_service, "Dashboard Service (domovoy-dashboard)", "ASP.NET Core :8091", "Aggregates telemetry statistics and device summaries for the UI")
    Container(mock_device, "Mock Device Server", "ASP.NET Core :30001", "Emulates smart home hardware endpoints for testing")

    ContainerDb(postgres, "Database (PostgreSQL)", "PostgreSQL 16", "Stores user accounts, device credentials, rules, command logs, notification settings")
    ContainerDb(redis, "Distributed Cache (Redis)", "Redis 7", "Caches user claims (devices/rooms access), latest telemetry, and audit logs")
    ContainerQueue(rabbitmq, "Message Broker (RabbitMQ)", "RabbitMQ 3.12 (MassTransit)", "Asynchronous event-driven communication between microservices")
}

' Relations - Entry Points
Rel(user, web_app, "Uses UI", "HTTPS")
Rel(web_app, gateway, "API Requests", "HTTPS/JSON :8085")
Rel(user, gateway, "Direct API / Mobile", "HTTPS/JSON :8085")
Rel(iot_device, gateway, "1. Authenticates & 2. Sends Telemetry", "HTTPS/JSON :8085")

' Relations - Gateway to Microservices
Rel(gateway, auth_service, "Proxies /connect/token, /api/auth, /api/devices/{id}/telemetry", "HTTP/JSON :8086")
Rel(gateway, device_manager, "Proxies /api/device-mgmt", "HTTP/JSON :8087")
Rel(gateway, rules_engine, "Proxies /api/rules", "HTTP/JSON :8088")
Rel(gateway, command_dispatcher, "Proxies /api/commands", "HTTP/JSON :8089")
Rel(gateway, notification_service, "Proxies /api/notifications", "HTTP/JSON :8090")
Rel(gateway, dashboard_service, "Proxies /api/dashboard", "HTTP/JSON :8091")

' Relations - Data Stores
Rel_R(gateway, redis, "Enriches headers via claims cache & logs audits", "Redis Protocol")
Rel(auth_service, postgres, "Reads/Writes user accounts, device credentials", "EF Core")
Rel(auth_service, redis, "Caches latest device telemetry", "StackExchange.Redis")
Rel(device_manager, postgres, "Reads/Writes device metadata", "EF Core")
Rel(rules_engine, postgres, "Reads/Writes automation rules", "EF Core")
Rel(command_dispatcher, postgres, "Reads device credentials, writes command logs", "EF Core")
Rel(notification_service, postgres, "Reads user notification preferences", "EF Core")
Rel(dashboard_service, postgres, "Reads aggregated statistics", "EF Core")

' Relations - RabbitMQ Events
Rel(auth_service, rabbitmq, "Publishes TelemetryReceivedEvent, AuthAuditEvents", "MassTransit")
Rel(device_manager, rabbitmq, "Publishes DeviceUpdatedEvent", "MassTransit")
Rel(rabbitmq, rules_engine, "Consumes TelemetryReceivedEvent", "MassTransit")
Rel(rules_engine, rabbitmq, "Publishes ExecuteCommandEvent, RuleTriggeredEvent", "MassTransit")
Rel(rabbitmq, command_dispatcher, "Consumes ExecuteCommandEvent", "MassTransit")
Rel(command_dispatcher, rabbitmq, "Publishes CommandFailedEvent", "MassTransit")
Rel(rabbitmq, notification_service, "Consumes RuleTriggeredEvent, CommandFailedEvent", "MassTransit")
Rel(rabbitmq, gateway, "Consumes ClaimsCache & Audit events", "MassTransit")

' Relations - External Dispatch & Notifications
Rel(command_dispatcher, mock_device, "Dispatches HTTP POST commands", "HTTP JSON :30001")
Rel(command_dispatcher, iot_device, "Dispatches commands", "HTTP POST / MQTT / Zigbee")
Rel(notification_service, telegram, "Sends alerts", "Telegram Bot API")
Rel(notification_service, smtp, "Sends email alerts", "SMTP")

@enduml

@startuml Domovoy_Telemetry_Flow
autonumber
skinparam BoxPadding 10
skinparam ParticipantPadding 10

actor "IoT Device" as iot
box "Domovoy System" #LightBlue
    participant "API Gateway" as gateway
    participant "Redis" as redis
    participant "Auth Service" as auth
    participant "RabbitMQ" as rabbitmq
    participant "Rules Engine" as rules
    participant "Command Dispatcher" as dispatcher
    participant "Notification Service" as notif
    participant "Mock Device / IoT" as target_dev
end box
actor "Telegram / Email" as client_channel

== Authentication ==
iot -> gateway: POST /api/device-auth/authenticate\n{networkDeviceId, secret}
gateway -> auth: Proxy request
auth -> auth: Validate secret against hash in DB
auth --> gateway: JWT Token (HS256)
gateway --> iot: JWT Token

== Telemetry Ingress ==
iot -> gateway: POST /api/devices/{id}/telemetry\nHeader: Bearer JWT\nBody: {temperature: 26.5, humidity: 60}
gateway -> gateway: Validate JWT & enrich headers (X-Domovoy-UserId)
gateway -> auth: Proxy telemetry request
auth -> auth: Verify URL DeviceId == Token DeviceId
auth -> redis: Update latest telemetry cache
auth -> rabbitmq: Publish TelemetryReceivedEvent\n{DeviceId, Data, Timestamp}
auth --> gateway: 200 OK
gateway --> iot: 200 OK

== Rule Evaluation ==
rabbitmq -> rules: Deliver TelemetryReceivedEvent
rules -> rules: Parse telemetry JSON & fetch active rules
rules -> rules: Evaluate expression (NCalc, e.g. "temperature > 25")
alt Rule condition met
    rules -> rabbitmq: Publish ExecuteCommandEvent\n{DeviceId, Command: "turn_on_cooler", TargetDeviceId}
    rules -> rabbitmq: Publish RuleTriggeredEvent\n{RuleId, DeviceId, Message}
end

== Command Execution ==
rabbitmq -> dispatcher: Deliver ExecuteCommandEvent
dispatcher -> dispatcher: Lookup device protocol & endpoint (HTTP/MQTT/Zigbee)
dispatcher -> target_dev: Dispatch command (e.g. POST http://mock-dev:30001/api/devices/cooler/command)
alt Command succeeds
    target_dev --> dispatcher: 200 OK
    dispatcher -> dispatcher: Update CommandLog (status: Executed)
else Command fails
    dispatcher -> rabbitmq: Publish CommandFailedEvent\n{DeviceId, Command, ErrorReason}
end

== Notification Dispatch ==
rabbitmq -> notif: Deliver RuleTriggeredEvent / CommandFailedEvent
notif -> notif: Check user channel preferences (Telegram / Email)
notif -> client_channel: Send Telegram message / Email alert

@enduml

@startuml Domovoy_User_Device_Registration_Flow
autonumber
actor "User Client" as client
box "Domovoy System" #LightBlue
    participant "API Gateway" as gateway
    participant "Redis" as redis
    participant "Auth Service" as auth
    participant "PostgreSQL" as db
    participant "RabbitMQ" as rabbitmq
end box

== User Registration & Login ==
client -> gateway: POST /api/auth/register\n{username, email, password}
gateway -> auth: Proxy registration
auth -> auth: Hash password (Identity / BCrypt)
auth -> db: Create User record
auth --> gateway: 201 Created
gateway --> client: 201 Created

client -> gateway: POST /connect/token or /api/auth/login\n{username, password}
gateway -> auth: Proxy login / OAuth2 password grant
auth -> db: Verify user credentials
auth -> auth: Generate Access Token (JWT) & Refresh Token
auth -> rabbitmq: Publish UserLoggedInEvent
auth --> gateway: 200 OK (Access + Refresh tokens)
gateway --> client: 200 OK (tokens)

rabbitmq -> gateway: (ClaimsCacheConsumer) Clear/update claims in Redis
rabbitmq -> gateway: (AuthAuditConsumer) Push LOGIN event to Redis audit log

== Device Registration (Claiming) ==
client -> gateway: POST /api/devices/register\nHeader: Bearer User-JWT\nBody: {networkDeviceId, roomId, name, protocol, endpoint}
gateway -> gateway: Extract UserId from JWT claims
gateway -> auth: Proxy device registration
auth -> auth: Generate cryptographically secure device secret
auth -> db: Save DeviceCredentials (OwnerId, NetworkDeviceId, HashedSecret)
auth -> rabbitmq: Publish DeviceUpdatedEvent / AuthAuditEvent
auth --> gateway: 201 Created\n{networkDeviceId, secret}
gateway --> client: 201 Created\n{networkDeviceId, secret} (Shown once for IoT provisioning)

@enduml